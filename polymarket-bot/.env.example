# Your Polygon wallet private key (the wallet connected to Polymarket)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your Polymarket funder/profile address (the address you deposit USDC to)
FUNDER_ADDRESS=0xYOUR_POLYMARKET_ADDRESS_HERE

# Signature type: 0 = browser wallet (MetaMask), 1 = email/Magic login
SIGNATURE_TYPE=0

# Trading Config
TRADE_AMOUNT_USDC=10
MAX_POSITION_USDC=100
MAX_OPEN_POSITIONS=5
MIN_EDGE=0.05
STRATEGY=value

# Proxy (optional - HTTP or SOCKS5)
# PROXY_URL=http://user:pass@host:port
# PROXY_URL=socks5://user:pass@host:port

# BTC Strategy
# BTC_ENABLED=true
# BTC_LOTTERY_AMOUNT=3          # MAX per lottery bet (bot sizes $0.50 to this amount)
# BTC_LOTTERY_MAX_PRICE=0.02    # Max price per share for lottery (2¢)
# BTC_MAX_LOTTERY_BETS=10       # Max concurrent lottery bets
# BTC_MOMENTUM_AMOUNT=5         # Per momentum trade

# Server
PORT=3000
